        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Khởi tạo và đặt kích thước cho biểu đồ\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "# 2. Vẽ biểu đồ cột đứng tự động lấy dữ liệu từ DataFrame\n",
        "plt.bar(df['Tên'], df['Điểm tổng kết'], color='skyblue', edgecolor='black')\n",
        "\n",
        "# 3. Thêm tiêu đề và nhãn cho các trục tọa độ\n",
        "plt.title('Biểu đồ thể hiện Điểm tổng kết của 10 sinh viên', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Tên sinh viên', fontsize=12)\n",
        "plt.ylabel('Điểm tổng kết', fontsize=12)\n",
        "\n",
        "# Đặt giới hạn trục tung từ 0 đến 10 để dễ quan sát\n",
        "plt.ylim(0, 10)\n",
        "\n",
        "# Thêm lưới mờ cho trục tung\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "\n",
        "# 4. Tự động điền số điểm cụ thể lên đầu mỗi cột\n",
