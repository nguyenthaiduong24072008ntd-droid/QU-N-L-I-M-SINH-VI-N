      "source": [
        "import pandas as pd\n",
        "\n",
        "# Tạo danh sách gồm 10 tên\n",
        "danh_sach_ten = [\n",
        "    \"An\", \"Dương\", \"Vương\", \"Ba\", \"Đình\",\n",
        "    \"Lan\", \"Mai\", \"Minh\", \"Tuấn\", \"Như\"\n",
        "]\n",
        "\n",
        "# Tạo điểm chuyên cần\n",
        "điểm_chuyên_cần = []\n",
        "print(\"Nhập điểm chuyên cần cho từng học sinh :\")\n",
        "for ten in danh_sach_ten:\n",
        "    điểm = int(input (f\"Nhập điểm chuyên cần cho {ten}) :\"))\n",
        "    điểm_chuyên_cần.append(điểm)\n",
        "# Tạo điểm giữa kỳ\n",
        "điểm_giữa_kỳ =[]\n",
        "print(\"Nhập điểm giữa kỳ cho từng học sinh :\")\n",
        "for ten in danh_sach_ten:\n",
        "    điểm = int(input (f\"Nhập điểm giữa kỳ cho {ten}) :\"))\n",
        "    điểm_giữa_kỳ.append(điểm)\n",
        "# Tạo điểm cuối kỳ\n",
        "điểm_cuối_kỳ =[]\n",
        "print(\"Nhập điểm cuối kỳ cho từng học sinh :\")\n",
        "for ten in danh_sach_ten:\n",
        "    điểm = int(input (f\"Nhập điểm cuối kỳ cho {ten}) :\"))\n",
        "    điểm_cuối_kỳ.append(điểm)\n",
        "# Xếp loại học sinh\n",
        "def phan_loai(điểm_tổng_kết):\n",
        "    if điểm_tổng_kết >=8.5:\n",
        "        return \"Giỏi\"\n",
        "    elif 7 <= điểm_tổng_kết < 8.5:\n",
        "        return \"Khá\"\n",
        "    elif 5 <= điểm_tổng_kết < 7:\n",
        "        return \"Trung bình\"\n",
        "    else:\n",
        "        return \"Yếu\"\n",
        "\n",
        "# Tạo DataFrame từ danh sách\n",
        "df = pd.DataFrame({\n",
        "    \"Tên\": danh_sach_ten,\n",
        "    \"Điểm chuyên cần\": điểm_chuyên_cần,\n",
        "    \"Điểm giữa kỳ\": điểm_giữa_kỳ,\n",
        "    \"Điểm cuối kỳ\": điểm_cuối_kỳ\n",
        "})\n",
        "# Thêm cột điểm chuyên cần vào DataFrame\n",
        "df[\"Điểm chuyên cần\"] = điểm_chuyên_cần\n",
        "# Thêm cột điểm giữa kỳ vào DataFrame\n",
        "df[\"Điểm giữa kỳ\"] = điểm_giữa_kỳ\n",
        "# Thêm cột điểm cuối kỳ cào DatFrame\n",
        "df[\"Điểm cuối kỳ\"] =điểm_cuối_kỳ\n",
        "# Thêm cột điểm Tổng kết vào DataFrame\n",
        "df[\"Điểm tổng kết\"] =(\n",
        "                      df['Điểm chuyên cần']*0.2\n",
        "                      +df[\"Điểm giữa kỳ\"]*0.3\n",
        "                      +df[\"Điểm cuối kỳ\"]*0.5\n",
        ")\n",
        "# Thêm cột xếp loại\n",
        "df[\"Xếp loại\"] = df[\"Điểm tổng kết\"].apply(phan_loai)\n",
        "# Hiển thị DataFrame\n",
        "display(df)"
      ],
