        "print(\"Thống Kê\")\n",
        "# Điểm tổng kết trung bình của lớp\n",
        "trung_bình = df[\"Điểm tổng kết\"].mean()\n",
        "print(f\"Điểm tổng kết trung bình của lớp là : {trung_bình:.2f}\")\n",
        "\n",
        "# Sinh viên có điểm tổng kết cao nhất\n",
        "sinh_viên_cao = df.loc[df[\"Điểm tổng kết\"].idxmax()]\n",
        "\n",
        "# Sinh viên có điểm tổng kết thấp nhất\n",
        "sinh_viên_thấp = df.loc[df[\"Điểm tổng kết\"].idxmin()]\n",
        "\n",
        "# Số sinh viên đạt (>=5)\n",
        "so_sinh_viên_đạt = (df[\"Điểm tổng kết\"] >= 5).sum()\n",
        "\n",
        "# Tự động điền dữ liệu vào bảng thống kê\n",
        "bang_thong_ke = pd.DataFrame({\n",
        "    \"Chỉ tiêu\": [\n",
        "        \"Điểm tổng kết trung bình cả lớp\",\n",
        "        f\"Điểm tổng kết cao nhất ({sinh_viên_cao['Tên']})\",\n",
        "        f\"Điểm tổng kết thấp nhất ({sinh_viên_thấp['Tên']})\",\n",
        "        \"Số lượng sinh viên đạt (>=5)\"\n",
        "    ],\n",
        "    \"Số liệu\": [\n",
        "        round(trung_bình, 2),\n",
        "        sinh_viên_cao[\"Điểm tổng kết\"],\n",
        "        sinh_viên_thấp[\"Điểm tổng kết\"],\n",
        "        so_sinh_viên_đạt\n",
        "    ]\n",
        "})\n",
        "\n",
        "# Hiển thị bảng chạy kết quả\n",
        "display(bang_thong_ke)"
